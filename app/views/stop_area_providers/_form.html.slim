= simple_form_for [@workbench, :stop_area_referential, @stop_area_provider], html: {class: 'form-horizontal', id: 'stop_area_provider_form'}, wrapper: :horizontal_form do |f|
  .row
    .col-lg-12
      = f.input :name
      = f.input :short_name

  .separator.section_separator

  .row
    .col-lg-12
      h2.mb-lg= t("stop_area_providers.form.sections.permission_restrictions")
      = f.input :allowed_stop_area_types, as: :autocomplete_select, collection: Chouette::AreaType.options(:all), label_method: :first, input_html: { multiple: true }

  = f.button :submit, t('actions.submit'), class: 'formSubmitr', form: 'stop_area_provider_form'
