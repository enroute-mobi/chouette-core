- breadcrumb :equipements, @workbench

.page_content
  .container-fluid
    .row
      .col-lg-12
          = render 'filters'

    - if @equipements.any?
      .row
        .col-lg-12
          = table_builder_2 @equipements,
            [ \
              TableBuilderHelper::Column.new( \
                key: :name, \
                attribute: :name, \
                sortable: false, \
                link_to: lambda do |equipement| \
                workbench_shape_referential_equipement_path( \
                    @workbench, \
                    equipement \
                  ) \
                end \
              ), \
              TableBuilderHelper::Column.new( \
                key: :stop_area, \
                attribute: Proc.new{|equipement| equipement.stop_area.name}, \
                sortable: false, \
                link_to: lambda do |equipement| \
                workbench_stop_area_referential_stop_area_path( \
                    @workbench, \
                    equipement.stop_area \
                  ) \
                end \
              ), \
              TableBuilderHelper::Column.new( \
                name: Equipement.human_attribute_name(:shape_provider), \
                attribute: Proc.new{|equipement| equipement.shape_provider.name}, \
                sortable: false \
              ), \
              TableBuilderHelper::Column.new( \
                key: :public_code, \
                attribute: :public_code, \
                sortable: false \
              ), \
            ].compact,
            cls: 'table has-filter has-search'

          = new_pagination @equipements, 'pull-right'

    - unless @equipements.any?
      .row.mt-xs
        .col-lg-12
          = replacement_msg t('equipements.search_no_results')
