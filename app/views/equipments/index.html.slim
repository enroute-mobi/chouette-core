- breadcrumb :equipments, @workbench

.page_content
  .container-fluid
    .row
      .col-lg-12
          = render 'filters'

    - if @equipments.any?
      .row
        .col-lg-12
          = table_builder_2 @equipments,
            [ \
              TableBuilderHelper::Column.new( \
                key: :objectid, \
                attribute: Proc.new { |n| n.get_objectid.try(:short_id) }, \
                sortable: false \
              ), \
              \
              TableBuilderHelper::Column.new( \
                key: :name, \
                attribute: :name, \
                sortable: false, \
                link_to: lambda do |equipment| \
                workbench_stop_area_referential_equipment_path( \
                    @workbench, \
                    equipment \
                  ) \
                end \
              ), \
              TableBuilderHelper::Column.new( \
                key: :stop_area, \
                attribute: Proc.new{|equipment| equipment.stop_area.name}, \
                sortable: false, \
                link_to: lambda do |equipment| \
                workbench_stop_area_referential_stop_area_path( \
                    @workbench, \
                    equipment.stop_area \
                  ) \
                end \
              ), \
              TableBuilderHelper::Column.new( \
                name: StopAreaProvider.model_name.human, \
                attribute: Proc.new{|equipment| equipment.stop_area_provider.name}, \
                sortable: false, \
                link_to: lambda do |equipment| \
                workbench_stop_area_referential_stop_area_provider_path( \
                    @workbench, \
                    equipment.stop_area_provider \
                  ) \
                end \
              ), \
              TableBuilderHelper::Column.new( \
                key: :public_code, \
                attribute: :public_code, \
                sortable: false \
              ), \
            ].compact,
            cls: 'table has-filter has-search'

          = new_pagination @equipments, 'pull-right'

    - unless @equipments.any?
      .row.mt-xs
        .col-lg-12
          = replacement_msg t('equipments.search_no_results')
