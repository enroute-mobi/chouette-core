- breadcrumb @user

- page_header_content_for @user

.page_content
  .container-fluid
    .row
      .col-lg-6.col-md-6.col-sm-12.col-xs-12
        = simple_block_for @user, title: t('metadatas') do |d|
          = d.attribute :name
          = d.attribute :email
          = d.attribute :state, value: @user.state_i18n
          = d.attribute :profile, value: @user.profile_i18n
          = d.attribute :enable_internal_password_authentication, as: :boolean
          - if @user.state == :invited
            = d.attribute :invitation_sent_at, as: :datetime
          - else
            = d.attribute :last_sign_in_at, as: :datetime
          = d.attribute :locked_at, as: :datetime
          = d.attribute :created_at, as: :datetime
          = d.attribute :updated_at, as: :datetime
