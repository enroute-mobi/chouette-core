- breadcrumb :workgroup_processing_rule, @workgroup, @processing_rule

- page_header_content_for @processing_rule
- content_for :page_header_title, @processing_rule.name, flush: true

.page_content
  .container-fluid
    .row
      .col-lg-6.col-md-6.col-sm-12.col-xs-12
        = simple_block_for @processing_rule, title: 'Information' do |d|
          = d.attribute :operation_step, value: @processing_rule.operation_step.text
          = d.attribute :target_workbenches, value: @processing_rule.target_workbench_names
          = d.attribute :processable_type, value: @processing_rule.processable.class.model_name.human
          = d.attribute :processable, as: :association, label: @processing_rule.processable.class.model_name.human
          = d.attribute :created_at, as: :datetime
          = d.attribute :updated_at, as: :datetime

      - if @processing_rule.scheduling?
        .col-lg-6.col-md-6.col-sm-12.col-xs-12
          = simple_block_for @processing_rule, title: t('processing_rule/workgroups.show.scheduling') do |d|
            - @processing_rule.schedulings.each do |scheduling|
              = d.attribute :scheduled_time, as: :time_of_day, object: scheduling, label: ProcessingRule::Scheduling.human_attribute_name(:scheduled_time)
              = d.attribute :scheduled_days, object: scheduling, label: ProcessingRule::Scheduling.human_attribute_name(:scheduled_days), value: %w(monday tuesday wednesday thursday friday saturday sunday).collect{ |day| content_tag(:span, t("calendars.days.#{day}"), class: "label label-default #{scheduling.scheduled_days.send(day + '?') ? '' : 'disabled'}") }.join.html_safe
              = d.attribute :target, object: scheduling, label: ProcessingRule::Scheduling.human_attribute_name(:target), value: t("processing_rule/workgroups.form.target_options.#{scheduling.target}")
              = d.attribute :next_schedule, as: :datetime, object: scheduling, label: ProcessingRule::Scheduling.human_attribute_name(:next_schedule)
