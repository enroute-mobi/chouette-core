.nested-fields.widgets.mb-4.border.rounded-r-lg.overflow-hidden[x-data="{ widget_type: #{f.object.widget_type.to_json} }" :class="#{widget_colors_alpine_class}"]
  .px-4.py-3.border-b
    .flex.justify-between.items-center
      .flex.items-center.space-x-2
        - if f.object.widget_type.blank?
          i.fa.fa-question-circle.text-gray-500.text-xl.mr-2
        - else
          = widget_icon(f.object.widget_type)
        h3.text-sm.font-bold.text-gray-700.my-0
          = f.object.widget_type&.text || t('dashboards.widgets.new_widget')
      .flex.items-center.space-x-2
        = link_to_remove_association f, class: 'text-red-600 hover:text-red-800 ml-2' do
          i.fa.fa-trash

  .p-4.bg-white.rounded-br-lg
    .grid.grid-cols-1.md:grid-cols-2.gap-4
      = f.input :name, wrapper_html: { class: 'mb-4' }
      = f.input :widget_type, include_blank: false, disabled: f.object.persisted?, wrapper_html: { class: 'mb-4' }, input_html: { 'x-model': 'widget_type' }

    - if f.object.widget_type == 'static_text' || local_assigns[:dynamic]
      - static_text_setup = f.object.widget_type == 'static_text' ? f.object.setup : Widget::StaticText.new
      template[x-if="widget_type === 'static_text'"]
        = f.simple_fields_for(:setup, static_text_setup) do |setup_form|
          .widget-content-field.mt-4[x-cloak]
            = setup_form.input :content, as: :text, input_html: { rows: 6, placeholder: t('dashboards.widgets.content_placeholder') }, wrapper_html: { class: 'mb-4' }
