- breadcrumb :stop_area_provider, @workbench, @stop_area_provider
- page_header_content_for @stop_area_provider

/ PageContent
.page_content
  .container-fluid
    .row
      .col-lg-6.col-md-6.col-sm-12.col-xs-12
        = simple_block_for @stop_area_provider, title: t('metadatas') do |d|
          = d.attribute :short_id, label: t('id_reflex'), value: @stop_area_provider.get_objectid.short_id
          = d.attribute :name
          = d.attribute :short_name
          = d.attribute :workbench, as: :association
          - stop_areas_count = @stop_area_provider.stop_areas.size
          = d.attribute :stop_areas, label: Chouette::StopArea.model_name.human_plural, value: "#{stop_areas_count} #{Chouette::StopArea.model_name.human(count: stop_areas_count)}"

        = simple_block_for @stop_area_provider, title: t('stop_area_providers.form.sections.permission_restrictions') do |d|
          = d.attribute :disable_stop_area_manual_creation, as: :boolean
          = d.attribute :allowed_stop_area_types, value: @stop_area_provider.allowed_stop_area_types.map { |area_type| Chouette::AreaType.find(area_type).label }.join(', ').presence || t('all.masculine')
