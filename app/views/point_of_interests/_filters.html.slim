= simple_search_for @search, workbench_shape_referential_point_of_interests_path(@workbench) do |f|
  = f.row
    = f.name
  = f.row
    = f.input :zip_code, width: 1
    = f.input :city_name, width: 1
    = f.input :category, as: :tom_select, collection: @search.candidate_categories.map { |l| {id: l.id, text: l.name } }, width: 2
    = f.input :shape_provider_id, as: :autocomplete_select, collection: @search.candidate_shape_providers, width: 2

