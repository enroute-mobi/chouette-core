.nested-fields.flex.items-center.mb-10.processing-rule-schedulings
  .flex.flex-col.w-full.mr-6
    = f.input :scheduled_time, as: :time_picker
    = f.input :scheduled_days, as: :day_type
    = f.input :target, as: :select, collection: ProcessingRule::Scheduling.target.options, include_blank: false

  .flex.mb-28
    = link_to_remove_association '', f, class: 'fa fa-trash text-red-600'
