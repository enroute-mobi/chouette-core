= simple_search_for @search, workbench_notification_rules_path(@workbench) do |f|
  = f.row
    = f.input :email, label: false, width: 2, placeholder: 'Email'
  = f.row
    = f.input :rule_type, as: :autocomplete_select, label: NotificationRule.tmf(:rule_type)
    = f.input :operation_statuses, as: :autocomplete_select, collection: @search.candidate_operation_statuses, label_method: lambda{|slug| operation_status(slug, verbose: true) }, value_method: lambda{|slug| slug }, input_html: { multiple: true, style: 'width: 100%' }
  = f.row
    = f.input :lines, as: :autocomplete_select, collection: @search.candidate_lines, label_method: :display_name, input_html: { multiple: true, style: 'width: 100%' }
    = f.input :start_date, as: :date_picker
    = f.input :end_date, as: :date_picker
