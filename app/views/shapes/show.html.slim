- breadcrumb :shape, @workbench, @shape
- page_header_content_for @shape
- javascript_additional_packs 'shapes/show'

.page_content
  .container-fluid
    .row
      .col-md-6.col-sm-12
        = simple_block_for @shape, title: t('metadatas') do |d|
          = d.attribute :uuid
          = d.attribute :name, value: @shape.name.presence || I18n.t('none')
          = d.attribute :length
          = d.attribute :points, value: @shape.geometry.points.count
          = d.attribute :created_at, as: :datetime
          = d.attribute :updated_at, as: :datetime

      .col-md-6.col-sm-12
        = render 'codes/block', model: @shape

    .row
      .col-md-12.col-sm-12
        h4.underline= t('lines.show.map')
        #route_map.large_map.mb-lg
