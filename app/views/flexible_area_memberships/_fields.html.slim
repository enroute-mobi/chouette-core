.nested-fields
  = f.input :id, as: :hidden, wrapper: false
  .wrapper
    = f.input :member_id,
      as: :ajax_select,
      collection: [f.object.member].compact,
      label_method: :formatted_selection_details,
      input_html: { 'data-url': autocomplete_workbench_stop_area_referential_stop_areas_path(@workbench, format: :json), 'data-ajax-html': true }
    div
      = link_to_remove_association '', f, class: 'fa fa-trash'
