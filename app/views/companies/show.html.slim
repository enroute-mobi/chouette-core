- breadcrumb :company, @workbench, @company

- page_header_content_for @company

.page_content
  .container-fluid

    .row
      .col-lg-6.col-md-6.col-sm-6.col-xs-6
        = simple_block_for @company, title: t('companies.form.sections.identification') do |d|
          = d.attribute :id, value: @company.get_objectid&.short_id
          = d.attribute :name
          = d.attribute :short_name
          = d.attribute :code
          = d.attribute :default_language
          = d.attribute :time_zone
          = d.attribute :fare_url, as: :url
          = d.attribute :objectid

        = simple_block_for @company, title: t('companies.form.sections.address') do |d|
          = d.attribute :house_number
          = d.attribute :address_line_1
          = d.attribute :address_line_2
          = d.attribute :street
          = d.attribute :town
          = d.attribute :postcode
          = d.attribute :postcode_extension
          = d.attribute :country, as: :country

        = render 'codes/block', model: @company

      .col-lg-6.col-md-6.col-sm-12.col-xs-12
        = simple_block_for @company, title: Chouette::Company.human_attribute_name(:default_contact) do |d|
          = d.attribute :default_contact_name
          = d.attribute :default_contact_email
          = d.attribute :default_contact_phone
          = d.attribute :default_contact_fax
          = d.attribute :default_contact_url, as: :url
          = d.attribute :default_contact_organizational_unit
          = d.attribute :default_contact_operating_department_name
          = d.attribute :default_contact_more

        - %i[private_contact customer_service_contact].each do |contact|
          - if @company.send(:"has_#{contact}?")
            = simple_block_for @company, title: Chouette::Company.human_attribute_name(contact) do |d|
              = d.attribute :"#{contact}_name"
              = d.attribute :"#{contact}_email"
              = d.attribute :"#{contact}_phone"
              = d.attribute :"#{contact}_url", as: :url
              = d.attribute :"#{contact}_more"

        = simple_block_for @company, title: Chouette::Company.human_attribute_name(:is_referent) do |d|
          - if @company.is_referent
            = d.attribute :particulars, as: :count, value: @company.particulars
            - if @company.particulars.present?
              table.table.table-bordered.mt-5
                thead
                  tr
                    th scope="col"
                      = Chouette::Company.human_attribute_name(:id)
                    th scope="col"
                      = Chouette::Company.human_attribute_name(:name)
                tbody
                  - @company.particulars.limit(5).each do |c|
                    tr
                      td
                        = c.get_objectid.short_id
                      td
                        = link_to(c.name, workbench_line_referential_company_path(@workbench, c))
          - else
            = d.attribute :referent, as: :association, link: ->(referent) { workbench_line_referential_company_path(@workbench, referent) }

        = simple_block_for @company, title: t("companies.form.sections.internals") do |d|
          = d.attribute :line_provider, as: :association, link: ->(line_provider) { workbench_line_referential_line_provider_path(@workbench, @company.line_provider_id) }

        = render 'shared/documentable/documents', documentable: @company, document_memberships_path: workbench_line_referential_company_document_memberships_path(@workbench, @company)
