= simple_search_for @search, workbench_stop_area_referential_equipments_path(@workbench) do |f|
  = f.row
    = f.text
  = f.row
    = f.input :stop_area_id,
        as: :ajax_select,
        collection: @search.candidate_stop_areas,
        label_method: :display_name,
        input_html: { 'data-url': stop_areas_workgroup_autocomplete_index_path(@workbench.workgroup, format: :json) }
    = f.input :stop_area_provider, as: :autocomplete_select, collection: @search.stop_area_provider_options, label: Equipment.human_attribute_name(:stop_area_provider)
  = f.row
    = f.input :fixed, as: :autocomplete_select, label: Equipment.human_attribute_name(:fixed)
    = f.input :out_of_order, as: :autocomplete_select, label: Equipment.human_attribute_name(:out_of_order)
