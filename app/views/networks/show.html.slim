- breadcrumb :network, @workbench, @network
- page_header_content_for @network

.page_content
  .container-fluid
    .row
      .col-lg-6.col-md-6.col-sm-12.col-xs-12
        = simple_block_for @network, title: t('metadatas') do |d|
          = d.attribute :objectid, value: @network.get_objectid&.short_id
          = d.attribute :name
          = d.attribute :registration_number
          = d.attribute :comment

        = render 'codes/block', model: @network
