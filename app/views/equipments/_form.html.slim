= simple_form_for [@workbench, :stop_area_referential, @equipment], html: {class: 'form-horizontal', id: 'equipment_form'}, wrapper: :horizontal_form do |f|
  .row
    .col-lg-12
      h2.mb-lg= t("equipments.form.sections.identification")
      = f.input :name
      = f.association :stop_area, as: :select, collection: [f.object.stop_area_id], input_html: { data: { select2_ajax: 'true', url: autocomplete_workbench_stop_area_referential_stop_areas_path(@workbench), initvalue: {id: f.object.stop_area_id, text: f.object.stop_area.try(:formatted_selection_details)}}}
      = f.input :public_code
      = f.input :fixed, as: :switchable_checkbox
      = f.input :out_of_order, as: :switchable_checkbox

  .separator.section_separator

  .row
    .col-lg-12
      h2.mb-lg= t("equipments.form.sections.accessibility")
      = f.input :mobility_impaired_accessibility, as: :select, include_blank: false
  .row
    .col-md-6
      = f.input :wheelchair_accessibility, as: :select, include_blank: false
      = f.input :step_free_accessibility, as: :select, include_blank: false
      = f.input :lift_free_accessibility, as: :select, include_blank: false
    .col-md-6
      = f.input :escalator_free_accessibility, as: :select, include_blank: false
      = f.input :visual_signs_availability, as: :select, include_blank: false
      = f.input :audible_signals_availability, as: :select, include_blank: false
  .row
    .col-lg-12
      = f.input :description, as: :text

  .separator.section_separator

  .row
    .col-lg-12
      h2.mb-lg= t("equipments.form.sections.internal")
      = f.association :stop_area_provider, as: :select, collection: @workbench.stop_area_providers, include_blank: false, label: StopAreaProvider.model_name.human

  = render 'codes/form', form: f

  = cancel_button
  = f.button :submit, t('actions.submit'), class: 'formSubmitr', form: 'equipment_form'
