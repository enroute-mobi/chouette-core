- javascript_additional_packs 'stop_area_referentials/form', 'inputs/autocomplete_select'
-# server rendered locale rows take indices 0..n-1, rows added client side continue from n
- locales_count = @stop_area_referential.locales.size
= simple_form_for @stop_area_referential, url: workbench_stop_area_referential_path(@workbench), html: {class: 'form-horizontal', id: 'stop_area_referential_form', 'x-data': "localesForm({ firstIndex: #{locales_count} })"}, wrapper: :horizontal_form do |f|
  legend= StopAreaReferential.tmf(:stops_selection_displayed_fields)
  .row.locales
    .col-lg-12
      .row
        .col-md-4
          label{for="stops_selection_displayed_fields_name"}= Chouette::StopArea.tmf(:name)
        .col-md-8
          = check_box "stops_selection_displayed_fields", :name, checked: true, disabled: true

      - StopAreaReferential::STOPS_SELECTION_DISPLAYABLE_FIELDS.each do |f|
        .row
          .col-md-4
            label{for="stops_selection_displayed_fields_#{f}"}= StopAreaReferential.tmf(f)
          .col-md-8
            = check_box "stops_selection_displayed_fields", f, checked: @stop_area_referential.stops_selection_displayed_fields[f.to_s]


  - if has_feature?(:stop_area_localized_names)
    br
    legend= StopAreaReferential.tmf(:locales)
    .row.header
      .col-md-1
      .col-md-3= StopAreaReferential.tmf(:locale_name)
      .col-md-3= StopAreaReferential.tmf(:locale_code)
      .col-md-2= StopAreaReferential.tmf(:locale_default)
      .col-md-3= 'actions.delete'.t
    #locales_list.locales
      - f.object.sorted_locales.each_with_index do |locale, i|
        .row x-data="{ deleted: false }" x-bind:class="{ deleted: deleted }"
          .col-md-1= label_for_country @stop_area_referential.translate_code_to_official(locale['code'])
          .col-md-3= @stop_area_referential.locale_name(locale)
          .col-md-3
            = locale['code']
            = hidden_field "locales[#{i}]", :code, value: locale['code']
          .col-md-2= check_box "locales[#{i}]", :default, checked: locale['default']
          .col-md-3
            = hidden_field "locales[#{i}]", :delete, value: 0, 'x-bind:value': 'deleted ? 1 : 0'
            = link_to '#', class: 'delete-locale', title: 'actions.delete'.t, 'x-on:click.prevent': 'deleted = true' do
              = fa_icon :trash

      template[x-for="locale in addedLocales" :key="locale.index"]
        .row x-data="{ deleted: false }" x-bind:class="{ deleted: deleted }"
          .col-md-1
            span x-bind:class="flagClass(locale.alpha2)" x-bind:title="locale.name"
          .col-md-3 x-text="locale.name"
          .col-md-3
            span x-text="locale.code"
            input type="hidden" x-bind:name="`locales[${locale.index}][code]`" x-bind:value="locale.code"
          .col-md-2
            input type="hidden" x-bind:name="`locales[${locale.index}][default]`" value="0"
            input type="checkbox" value="1" x-bind:name="`locales[${locale.index}][default]`"
          .col-md-3
            input type="hidden" x-bind:name="`locales[${locale.index}][delete]`" x-bind:value="deleted ? 1 : 0"
            a.delete-locale href="#" title="#{'actions.delete'.t}" x-on:click.prevent="deleted = true"
              = fa_icon :trash

    .row.add-locales
      - used_countries = @stop_area_referential.locales.map { |l| StopAreaReferential.translate_code_to_official(l['code']).split('_').last }
      - countries = ISO3166::Country.all.select { |c| ! used_countries.include?(c.alpha2) }
      - countries = countries.sort_by { |c| c.translation(I18n.locale)}
      - locales_data = countries.map { |c| [c.translation(I18n.locale), StopAreaReferential.translate_code_to_internal("#{c.languages.first}_#{c.alpha2}"), c.alpha2] }
      - locale_options = locales_data.map { |name, code, _alpha2| [name, code] }
      - country_codes = locales_data.to_h { |_name, code, alpha2| [code, alpha2] }
      .col-md-12.flex.items-center
        = select_tag :add_locale, options_for_select(locale_options), include_blank: true, placeholder: 'actions.select'.t, class: 'w-1/5 autocomplete_select country-select', 'x-ref': 'addLocale', data: { country_codes: country_codes.to_json }
        = link_to '#', class: 'btn btn-primary add-locale', 'x-on:click.prevent': 'addLocale()' do
          = fa_icon :plus, {text: 'actions.add'.t}

  - unless has_feature?("route_stop_areas_all_types")
    br
    legend= StopAreaReferential.tmf(:route_edition_available_stops)
    .row.locales
      - Chouette::AreaType::COMMERCIAL.each do |f|
          .row
            .col-md-4
              label{for="route_edition_available_stops_#{f}"}= t("area_types.label.#{f}")
            .col-md-8
              = check_box "route_edition_available_stops", f, checked: @stop_area_referential.route_edition_available_stops[f.to_s]

  = cancel_button
  = f.button :submit, t('actions.submit'), class: 'formSubmitr', form: 'stop_area_referential_form'
