- @dashboard.widgets.each do |widget|
  .grid-stack-item[
    gs-x=widget.x
    gs-y=widget.y
    gs-w=widget.width
    gs-h=widget.height
    data-widget-id=widget.id
  ]
    .grid-stack-item-content
      .content-container
        .widget-drag-handle
          h3= widget.name
        .widget-content
          = render "dashboards/widgets/#{widget.widget_type}", widget: widget
