= simple_search_for @search, [@parent, :exports] do |f|
  = f.row
    = f.input :name, label: false, placeholder: I18n.t('exports.filters.name_or_creator_cont'), width: 2
  = f.row
    = f.input :statuses, as: :autocomplete_select, collection: @search.candidate_statuses.map(&:slug), label_method: lambda{|slug| operation_status(slug, verbose: true) }, input_html: { multiple: true, style: 'width: 100%' }
    - if @parent.is_a?(Workgroup)
      = f.input :workbench_ids, as: :autocomplete_select, collection: @search.candidate_workbenches.order('name'), label_method: :name, input_html: { multiple: true, style: 'width: 100%' }
    = f.input :start_date, as: :date_picker
    = f.input :end_date, as: :date_picker
