- breadcrumb :api_keys, @workbench

.page_content
  .container-fluid
    .row
      .col-lg-6.col-md-6.col-sm-12.col-xs-12
        = simple_block_for nil, title: t('metadatas') do |d|
          = d.attribute :workbench_id, value: @workbench.id, label: t('api_keys.workbench_id')

    - if @api_keys.any?
      .row
        .col-lg-12
          = table_builder_2 @api_keys,
            [ \
              TableBuilderHelper::Column.new( \
                key: :name, \
                attribute: :name, \
                sortable: false \
              ), \
              TableBuilderHelper::Column.new( \
                key: :token, \
                attribute: :token, \
                sortable: false \
              ), \
            ],
            cls: 'table'

    - else
      .row.mt-xs
        .col-lg-12
          = replacement_msg 'api_keys.search_no_results'.t

