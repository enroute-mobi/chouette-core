= simple_search_for @search, workbench_macro_list_runs_path(@workbench) do |f|
  = f.row
    = f.input :name, label: false, width: 2, placeholder: I18n.t('control_list_run.filters.name')
  = f.row
    = f.input :statuses, as: :autocomplete_select, collection: @search.candidate_statuses.map(&:slug), label_method: lambda{|slug| operation_status(slug, verbose: true) }, value_method: lambda{|slug| slug }, input_html: { multiple: true, style: 'width: 100%' }
    = f.input :start_date, as: :date_picker
    = f.input :end_date, as: :date_picker
